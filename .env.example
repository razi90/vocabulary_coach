# Make a copy: cp .env.example .env
# docker compose reads the file automatically. Every value is optional -
# without a .env the stack runs locally on the defaults from docker-compose.yml.

# Database password. Defaults to "voco"; Postgres publishes no port and is
# reachable only inside the Docker network.
POSTGRES_PASSWORD=voco

# Token for the MCP endpoint /mcp. Empty means no token, which is only
# defensible on 127.0.0.1. Generate one: openssl rand -hex 24
MCP_TOKEN=

# Second listener that serves /mcp exclusively - only that one gets tunnelled.
# If it is set, the server demands an MCP_TOKEN and refuses to start without one.
MCP_PORT=

# Set to 1 to turn the /mcp route off entirely - for a deployment that only
# serves the app to browsers and runs no agent against it.
MCP_DISABLED=

# ---------- Scheduled coach (agent/coach.js) ----------
# Only needed where the coach runs, not for the app itself.

# OpenRouter key for the model that writes the exercises.
OPENROUTER_API_KEY=

# Any model OpenRouter serves. Cheap open-weights first, swap once you have
# numbers on how often it survives create_exercise's validation.
COACH_MODEL=nousresearch/hermes-4-70b

# Where the coach reaches the MCP tools. Inside the same compose network the
# app is http://app:8080/mcp; from outside it is the public URL.
MCP_URL=http://127.0.0.1:8080/mcp
