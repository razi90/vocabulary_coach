# Make a copy: cp .env.example .env
# docker compose reads the file automatically.

# Required. Encrypts the learners' API keys at rest. 32 random bytes, base64:
#   openssl rand -base64 32
# Keep it: if it changes, every stored API key has to be entered again.
APP_ENCRYPTION_KEY=

# The first account. It owns the learning progress from before multi-user and
# gets these credentials on the first start. Change the password in the app
# afterwards; these values are only used while the account has none.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# YouTube Data API v3 key, so the coach can find videos for the daily lesson.
# Free: Google Cloud Console -> new project -> enable "YouTube Data API v3" ->
# Credentials -> API key (restrict it to that API). Empty: the coach only uses
# YouTube links the learner pastes.
YOUTUBE_API_KEY=

# Whoever knows this code can create an account. Empty: registration closed.
REGISTRATION_CODE=

# Database password. Postgres publishes no port and is reachable only inside
# the Docker network.
POSTGRES_PASSWORD=voco

# Where the app listens. 127.0.0.1 = this machine only. To let others in,
# put an HTTPS reverse proxy in front, set APP_BIND=0.0.0.0 only if the proxy
# runs elsewhere, and set COOKIE_SECURE=true.
APP_BIND=127.0.0.1
COOKIE_SECURE=false
