# Make a copy: cp .env.example .env
# docker compose reads the file automatically. Every value is optional -
# without a .env the stack runs locally on the defaults from docker-compose.yml.

# Database password. Defaults to "voco"; Postgres publishes no port and is
# reachable only inside the Docker network.
POSTGRES_PASSWORD=voco

# Token for the MCP endpoint /mcp. Empty means no token, which is only
# defensible on 127.0.0.1. Generate one: openssl rand -hex 24
MCP_TOKEN=

# Second listener that serves /mcp exclusively - only that one gets tunnelled.
# If it is set, the server demands an MCP_TOKEN and refuses to start without one.
MCP_PORT=
